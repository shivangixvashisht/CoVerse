# Reference for environment variables read by the contracts workspace.
# These are read from the shell environment (no .env loader is configured yet).
# Never commit private keys or real RPC credentials.
#
# No private keys or RPC URLs are needed for local development:
# Hardhat's in-process network and `hardhat node` provide funded test accounts.

# Set to "true" to compile with the solc-js build from the `solc` npm package
# instead of downloading native solc from binaries.soliditylang.org
# (useful on restricted networks), e.g.  HARDHAT_USE_SOLCJS=true npm test
HARDHAT_USE_SOLCJS=false
