{
  "name": "coverse",
  "private": true,
  "version": "0.1.0",
  "description": "CoVerse \u2014 blockchain-powered revenue sharing for collaborative content creation.",
  "workspaces": [
    "frontend",
    "contracts"
  ],
  "scripts": {
    "dev": "npm run dev --workspace frontend",
    "build": "npm run build --workspace frontend",
    "lint": "npm run lint --workspace frontend",
    "test": "npm run test --workspace frontend && npm run test --workspace contracts",
    "contracts:compile": "npm run compile --workspace contracts",
    "contracts:test": "npm run test --workspace contracts",
    "contracts:node": "npm run node --workspace contracts",
    "contracts:deploy": "npm run deploy:local --workspace contracts",
    "contracts:export-abi": "npm run export-abi --workspace contracts"
  },
  "engines": {
    "node": ">=20"
  }
}
