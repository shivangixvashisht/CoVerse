# Frontend env vars must be prefixed with VITE_ and are PUBLIC (bundled into the client).
# Never put private keys, seed phrases or secrets here. Copy to `.env.local` to use.
#
# By default you do NOT need any of these: `npm run contracts:deploy` writes
# frontend/public/deployments/31337.json (git-ignored) and the app reads the address from it.

# Optional explicit contract address (overrides the deployment file). Must be on a supported test chain.
VITE_REGISTRY_ADDRESS=
# Chain the explicit address belongs to (only 31337 / Hardhat Local is supported).
VITE_REGISTRY_CHAIN_ID=31337
# RPC URL MetaMask should use when the app adds the local network (default http://127.0.0.1:8545).
VITE_RPC_URL=
